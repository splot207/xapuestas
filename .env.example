# Copia este archivo como .env y llena los valores.
# Los sacas de Vercel → tu proyecto → Storage → Upstash → .env.local (o de upstash.com)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opcional: usuario y contraseña del dashboard (si no, usa los de config.json)
# ADMIN_USER=admin
# ADMIN_PASS=admin
# SESSION_SECRET=una-frase-larga-cualquiera
